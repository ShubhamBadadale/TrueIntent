# TrueIntent configuration
#
# Copy to `.env` only if you need to override a default. Every value here is
# optional: the application starts with no configuration at all, and a fresh
# clone runs end-to-end with the defaults below.
#
# TrueIntent stores no secrets and persists no user data. There is no database,
# no auth, and no outbound network call in the serving path. Nothing listed
# here is ever echoed back in an API response.

# --- Frontend build/runtime -------------------------------------------------
# Base URL of the FastAPI backend, baked into the Vite bundle at build time.
# Leave unset for local development (defaults to http://localhost:8000).
# In Docker Compose this is supplied as a build argument.
# VITE_API_URL=http://localhost:8000

# --- Mobile client (Expo, read from mobile/ only) -----------------------------
# Base URL of the FastAPI backend, baked into the Expo bundle at build time
# (EXPO_PUBLIC_ prefix). Pick ONE value per environment — no source-code
# change is needed to switch environments, only a rebuild with a new value:
#   Android emulator:      EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
#   iOS simulator / web:   EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
#   Physical phone:        EXPO_PUBLIC_API_BASE_URL=http://<your-lan-ip>:8000
#   Deployed backend:      EXPO_PUBLIC_API_BASE_URL=https://api.example.com
# (EXPO_PUBLIC_TRUEINTENT_API_URL is still honoured as a legacy alias.)
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# --- Server -----------------------------------------------------------------
# Bind address and port for `python -m backend`. The defaults bind localhost
# only; the Docker image overrides the host to 0.0.0.0 (still published on
# localhost ports by docker-compose.yml).
# TRUEINTENT_HOST=127.0.0.1
# TRUEINTENT_PORT=8000

# --- CORS -------------------------------------------------------------------
# Explicit browser origins, comma-separated. When set, ONLY these origins are
# allowed. When empty (the default outside production), any localhost port is
# allowed so `npm run dev` works without configuration. Production should
# always enumerate origins explicitly.
# TRUEINTENT_CORS_ORIGINS=https://app.example.com
# Set to false to disable even the localhost fallback (same-origin only).
# TRUEINTENT_CORS_ALLOW_LOCALHOST=true
# The API is token-less, so credentialed requests are off by default.
# TRUEINTENT_CORS_ALLOW_CREDENTIALS=false
# Comma-separated list of allowed methods.
# TRUEINTENT_CORS_ALLOW_METHODS=GET,POST,OPTIONS

# --- Logging ----------------------------------------------------------------
# Level: DEBUG, INFO, WARNING, ERROR, CRITICAL. Every line carries the request
# ID; bodies, URLs, message text and headers are never logged.
# TRUEINTENT_LOG_LEVEL=INFO
# Format: text (human-readable) or json (one object per line, for shipping).
# TRUEINTENT_LOG_FORMAT=text

# --- Request tracing --------------------------------------------------------
# Inbound header accepted as the correlation ID (alphanumeric plus . _ : -,
# max 64 chars; anything else is replaced with a generated ID). The same value
# is returned in the response header and in every envelope's meta.request_id.
# TRUEINTENT_REQUEST_ID_HEADER=X-Request-ID

# --- Input limits -----------------------------------------------------------
# Hard ceilings; requests beyond them are rejected before analysis.
# TRUEINTENT_MAX_URL_CHARS=8192
# TRUEINTENT_MAX_TEXT_CHARS=20000
# TRUEINTENT_MAX_IMAGE_BYTES=10485760
# TRUEINTENT_MAX_IMAGE_PIXELS=10000000
# Whole-request ceiling (multipart framing included), enforced at the gate.
# TRUEINTENT_MAX_REQUEST_BYTES=12582912

# --- Module C (OCR) ---------------------------------------------------------
# Path to the Tesseract binary, needed only when pytesseract cannot find it on
# PATH (common on Windows). Leave unset on Linux/macOS where `apt`/`brew`
# installs it system-wide.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- OCR languages and timeout ----------------------------------------------
# Extra Tesseract language packs beyond the default English model. Unsupported
# or malformed values fall back to English rather than failing the request.
# TESSERACT_LANG=eng+hin
# Seconds before an OCR attempt is abandoned (1-120).
# TRUEINTENT_OCR_TIMEOUT_SECONDS=15

# --- Module A (IEEE-CIS amount-only benchmark) ------------------------------
# No configuration. The benchmark artifact is read from ml/models/module_a.pkl
# and requires authorized IEEE-CIS source data to (re)train. When absent the
# endpoint returns 503 rather than a substituted score.
