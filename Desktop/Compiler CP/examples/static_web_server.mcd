cloud app "StudentPortal" {
  network "main" {
    cidr = "10.0.0.0/16"
  }

  subnet "public" {
    cidr = "10.0.1.0/24"
    depends_on = ["main"]
  }

  firewall "web-fw" {
    depends_on = ["main"]
    allow = [
      { port = 80, protocol = "tcp", source = "0.0.0.0/0" },
      { port = 443, protocol = "tcp", source = "0.0.0.0/0" }
    ]
  }

  compute "web" {
    image = "ubuntu-22.04"
    cpu = 2
    memory = 4
    depends_on = ["public", "web-fw"]
  }
}
